		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Appiontments per Patient' = DIVIDE([Total Appointments],[Total Patients],0)
		lineageTag: be3c7ac5-0c5d-4cdd-bade-64207b229dca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Minimum Age' = MIN(HEALTHCONNENT_PREPARED_DATA[age])
		formatString: 0
		lineageTag: 06457bc6-2a6f-4292-8c4d-d0c88f97b851

	measure 'Maximum Age' = MAX(HEALTHCONNENT_PREPARED_DATA[age])
