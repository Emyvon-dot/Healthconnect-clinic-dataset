		lineageTag: d2e895ca-9223-42cf-93fe-a31510964217

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Booking Lead Days' = AVERAGE(HEALTHCONNENT_PREPARED_DATA[booking_lead_days])
		lineageTag: 23c35a5a-ced8-4712-ade9-67877966eeeb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High-Risk Appointment Count' = CALCULATE(DISTINCTCOUNT(HEALTHCONNENT_PREPARED_DATA[appiontment_id]),HEALTHCONNENT_PREPARED_DATA[Risk_score_group]="High Risk")
		formatString: 0
		lineageTag: 19b1b349-76b4-4535-9d5a-2fd2e93d84f3

	measure 'High-Risk No-Show' = CALCULATE(DISTINCTCOUNT(HEALTHCONNENT_PREPARED_DATA[appiontment_id]),HEALTHCONNENT_PREPARED_DATA[Risk_score_group]="High Risk",HEALTHCONNENT_PREPARED_DATA[Is_no_show]=1)
		formatString: 0
		lineageTag: efe3db9e-da7f-4aab-bfa0-370e84ad7bf9

	measure 'High-Risk No-Show Rate' = DIVIDE([High-Risk No-Show],[High-Risk Appointment Count],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3905ce53-a8dc-4f1d-85cf-8a895cc62532

	measure 'No-Reminder No-Show Rate' = CALCULATE([No-Show Rate],HEALTHCONNENT_PREPARED_DATA[reminder_sent]="No")
		lineageTag: 6b85fd9b-ea45-48aa-ad30-d6c7374280d8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reminder No-Show Rate' = CALCULATE([No-Show Rate],HEALTHCONNENT_PREPARED_DATA[reminder_sent]="Yes")
		lineageTag: 651e68b3-7fea-459d-8af3-8b015def7646

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reminder Effectiveness' = [No-Reminder No-Show Rate]-[Reminder No-Show Rate]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cdc4857e-2214-4707-888e-f6005ddd0442

	measure 'No-Show Rate by Reminder' = [No-Show Rate]
		lineageTag: 23c9ee3e-b165-42c1-8452-71b21133d84f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

