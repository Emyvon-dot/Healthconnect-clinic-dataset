	column Distance_group = SWITCH(TRUE(),HEALTHCONNENT_PREPARED_DATA[distance_to_clinic_km] <5, "0-5km", HEALTHCONNENT_PREPARED_DATA[distance_to_clinic_km] <=10,"6-10km", HEALTHCONNENT_PREPARED_DATA[distance_to_clinic_km] <=20,"11-20km", HEALTHCONNENT_PREPARED_DATA[distance_to_clinic_km]<=30,"21-30km", "above 30km")
		lineageTag: 51417d7a-9552-4b0d-bc47-59f4ae95c282
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Risk_score = IF([has_previous_no_shows]="Yes",2,0)+IF([booking_lead_days]>30,2,0)+IF([distance_to_clinic_km]>20,2,0)+IF([reminder_sent]="No",1,0)+IF([appointment_type]="Follow-up",1,0)
		formatString: 0
		lineageTag: e8908e76-9c5d-42f5-8cda-1d27c905d36f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Risk_score_group = SWITCH(TRUE(),[Risk_score]>=5,"High Risk", [Risk_score]>=3,"Medium Risk", "Low Risk")
		lineageTag: 0778dcda-8156-4235-8b37-a4c5f776617b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

