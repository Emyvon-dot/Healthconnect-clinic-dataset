table HEALTHCONNENT_PREPARED_DATA
	lineageTag: dcbbd8af-a4e0-4394-b3cd-aa5034814fd9

	measure 'Total Appointments' = DISTINCTCOUNT(HEALTHCONNENT_PREPARED_DATA[appiontment_id])
		formatString: 0
		lineageTag: c24acbc2-764a-4a36-8184-2f2075c2ae8e

	measure 'Total Patients' = DISTINCTCOUNT(HEALTHCONNENT_PREPARED_DATA[patient_id])
		formatString: 0
		lineageTag: b779c30a-53e1-422a-9825-59ca5138542a

	measure 'Total Attended' = CALCULATE([Total Appointments],HEALTHCONNENT_PREPARED_DATA[Is_attended] =1)
		formatString: 0
		lineageTag: 95811a1c-fe72-4760-aeb1-1b776426c12b

	measure 'Total No-Shows' = CALCULATE([Total Appointments],HEALTHCONNENT_PREPARED_DATA[Is_no_show]=1)
		formatString: 0
		lineageTag: b4b5ea39-070e-4ceb-838b-d6aa2b6a6c88

	measure 'Total Cancelled' = CALCULATE([Total Appointments],HEALTHCONNENT_PREPARED_DATA[Is_cancelled]=1)
		formatString: 0
		lineageTag: 7197f613-8196-4bf5-87c3-2c9cd4107894

	measure 'Attendance Rate' = DIVIDE([Total Attended],[Total Appointments],0)
		lineageTag: 96a9054f-374d-4347-9392-c0fe6f1e4731

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'No-Show Rate' = DIVIDE([Total No-Shows],[Total Appointments],0)
		lineageTag: 9662dcd9-5520-4cc9-a4f4-de97ca5f5b70

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cancellation Rate' = DIVIDE([Total Cancelled],[Total Appointments],0)
		lineageTag: 82a3bb45-2f0a-47bb-bae8-0f8a08a94861

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Reminder' = CALCULATE([Total Appointments],HEALTHCONNENT_PREPARED_DATA[reminder_received]=1)
		formatString: 0
		lineageTag: f934ebb3-5fcf-4cb3-af87-31608f93c38d

	measure 'Reminder Rate' = DIVIDE([Total Reminder],[Total Appointments],0)
		lineageTag: 95d32c8a-c6e5-4646-82fe-3e59b0d156a7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Age' = AVERAGE(HEALTHCONNENT_PREPARED_DATA[age])
		lineageTag: b5a79033-2f57-4443-bd8b-4fe7b8dc52cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Booking Lead Time' = AVERAGE(HEALTHCONNENT_PREPARED_DATA[booking_lead_days])
		lineageTag: f595718f-879e-4504-8408-4725fe8d3910

		annotation PBI_FormatHint = {"isGeneralNumber":true}

